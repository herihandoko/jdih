# PDF to MP3 Conversion Service Configuration

# Service Configuration
PDF_CONVERSION_ENABLED=true
PDF_CONVERSION_BATCH_SIZE=1
PDF_CONVERSION_MAX_RETRIES=3
SAVE_TEXT_CONTENT=true
SAVE_TEXT_FILE=false

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TTS_MODEL=tts-1
OPENAI_MAX_CHARS_PER_REQUEST=4000
OPENAI_RATE_LIMIT=50

# Google TTS Configuration (Fallback)
GOOGLE_TTS_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=path/to/google_credentials.json
GOOGLE_MAX_CHARS_PER_REQUEST=5000

# Audio Configuration
AUDIO_OUTPUT_FORMAT=mp3
AUDIO_SAMPLE_RATE=22050
AUDIO_BITRATE=128k
AUDIO_CHUNK_DELAY=0.5

# Storage Configuration
PDF_STORAGE_PATH=storage/places/peraturan
MP3_STORAGE_PATH=storage/places/mp3
TEMP_STORAGE_PATH=storage/temp

# Database Configuration
DB_HOST=localhost
DB_DATABASE=jdih
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
DB_PORT=3306

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/pdf_converter.log

# Rate Limiting
REQUEST_DELAY=2.0
BATCH_DELAY=3600.0 